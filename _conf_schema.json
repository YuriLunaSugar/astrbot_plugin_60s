{
  "enabled": {
    "type": "bool",
    "default": false,
    "description": "启用主动发送（确认目标后手动开启）"
  },
  "base_url": {
    "type": "string",
    "default": "https://60s.viki.moe",
    "description": "60s 服务基址，不含 /v2 路径"
  },
  "timezone": {
    "type": "string",
    "default": "Asia/Shanghai",
    "description": "IANA 时区"
  },
  "send_time": {
    "type": "string",
    "default": "09:00",
    "description": "每天发送时间 HH:MM"
  },
  "targets": {
    "type": "list",
    "default": [],
    "description": "完整 unified_msg_origin 列表，不是 API URL、适配器名称或裸群号"
  },
  "daily_enabled": {
    "type": "bool",
    "default": true,
    "description": "启用每天60秒读懂世界"
  },
  "history_enabled": {
    "type": "bool",
    "default": true,
    "description": "启用历史上的今天"
  },
  "catchup_minutes": {
    "type": "int",
    "default": 120,
    "description": "当天错过计划后允许补发的分钟数，1–1440，不跨日补发"
  },
  "timeout_seconds": {
    "type": "int",
    "default": 20,
    "description": "HTTP 和单次发送超时秒数，1–120"
  },
  "formats": {
    "type": "object",
    "description": "各接口发送格式（API 始终取 JSON，插件按选项发送）",

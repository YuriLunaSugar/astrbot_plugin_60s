{
  "enabled": {
    "type": "bool",
    "default": false,
    "description": "启用主动发送（确认目标后手动开启）"
  },
  "base_url": {
    "type": "string",
    "default": "https://60s.viki.moe",
    "description": "60s 服务基址，不含 /v2 路径"
  },
  "timezone": {
    "type": "string",
    "default": "Asia/Shanghai",
    "description": "IANA 时区"
  },
  "send_time": {
    "type": "string",
    "default": "09:00",
    "description": "旧配置兼容：没有单独开始时间时使用"
  },
  "targets": {
    "type": "list",
    "default": [],
    "description": "完整 unified_msg_origin 列表，不是 API URL、适配器名称或裸群号"
  },
  "daily_enabled": {
    "type": "bool",
    "default": true,
    "description": "启用每天60秒读懂世界"
  },
  "history_enabled": {
    "type": "bool",
    "default": true,
    "description": "启用历史上的今天"
  },
  "catchup_minutes": {
    "type": "int",
    "default": 120,
    "description": "旧配置兼容：没有单独结束时间时的补发窗口，结束边界不含且不跨日"
  },
  "timeout_seconds": {
    "type": "int",
    "default": 20,
    "description": "HTTP 和单次发送超时秒数，1–120"
  },
  "formats": {
    "type": "dict",
    "items": {},
    "default": {
      "daily": "text",
      "history": "text"
    },
    "invisible": true,
    "description": "旧版日更默认格式兼容；旧热榜格式保留但不再使用"
  },
  "image_hosts": {
    "type": "list",
    "default": [
      "mmbiz.qpic.cn"
    ],
    "description": "日报图片允许的 HTTPS 域名（精确匹配，不允许重定向）"
  },
  "target_formats": {
    "type": "template_list",
    "default": [],
    "description": "按目标设置两个日更接口的格式（目标必须先在 targets 中启用）",
    "templates": {
      "target": {
        "name": "目标日更格式",
        "display_item": "target",
        "items": {
          "target": {
            "type": "string",
            "default": "",
            "description": "完整目标会话标识",
            "_special": "umo"
          },
          "daily": {
            "type": "string",
            "default": "",
            "description": "每天60秒格式；留空继承旧默认",
            "options": [
              "",
              "text",
              "json",
              "markdown",
              "image"
            ]
          },
          "history": {
            "type": "string",
            "default": "",
            "description": "历史上的今天格式；留空继承旧默认",
            "options": [
              "",
              "text",
              "json",
              "markdown"
            ]
          }
        }
      }
    }
  },
  "schedules": {
    "type": "object",
    "description": "两个日更接口独立调度",
    "items": {
      "daily": {
        "type": "object",
        "description": "每天60秒",
        "items": {
          "send_time": {
            "type": "string",
            "default": "",
            "description": "每天发送时间 HH:MM；留空继承旧 send_time"
          },
          "retry_minutes": {
            "type": "int",
            "default": 15,
            "description": "等待重试分钟数，1–1440"
          },
          "end_time": {
            "type": "string",
            "default": "",
            "description": "最后结束时间 HH:MM（含该时刻）；早于开始表示跨午夜；留空沿用旧补发窗口"
          }
        }
      },
      "history": {
        "type": "object",
        "description": "历史上的今天",
        "items": {
          "send_time": {
            "type": "string",
            "default": "",
            "description": "每天发送时间 HH:MM；留空继承旧 send_time"
          },
          "retry_minutes": {
            "type": "int",
            "default": 15,
            "description": "等待重试分钟数，1–1440"
          },
          "end_time": {
            "type": "string",
            "default": "",
            "description": "最后结束时间 HH:MM（含该时刻）；早于开始表示跨午夜；留空沿用旧补发窗口"
          }
        }
      }
    }
  }
}
